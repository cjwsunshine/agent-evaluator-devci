# ========== 系统基础配置 ==========
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///instance/eval_platform.db

# ========== 评测工具配置 ==========
PROMPTFOO_PATH=promptfoo
DEEPEVAL_PATH=depeval
TRULENS_PATH=trulens

# ========== API密钥配置 ==========
OPENAI_API_KEY=your-openai-key-here

# ========== 火山方舟（Ark）/模型运行配置 ==========
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v3.2

# ========== RAGAS 专用配置（可选；用于与 coding 模型/endpoint 隔离） ==========
RAGAS_MODEL=your-ragas-chat-model-or-endpoint
RAGAS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=your-text-embedding-model-or-endpoint
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RAGAS_TIMEOUT_SECONDS=90

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE=app.log
